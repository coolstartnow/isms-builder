# ISMS Builder – Beispielkonfiguration
# Kopiere diese Datei als .env und passe die Werte an:
#   cp .env.example .env

# ── Pflichtfeld ───────────────────────────────────────────────────────────────
# Mindestens 32 zufällige Zeichen:  openssl rand -hex 32
# PFLICHT: Platzhalter ersetzen (openssl rand -hex 32). In Produktion (Docker-Image) startet der Server mit dem Platzhalter,
# einem fehlenden oder zu kurzen Secret (< 32 Zeichen) nicht.
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

# ── Server ────────────────────────────────────────────────────────────────────
JWT_EXPIRES_IN=8h
PORT=3000
DEV_HEADER_AUTH=false        # Nie auf true in Produktion!

# ── Storage-Backend ───────────────────────────────────────────────────────────
# json empfohlen, solange die SQL-Backend-Migration nicht abgeschlossen ist (siehe README-Status)
STORAGE_BACKEND=json         # json (empfohlen) | sqlite | mariadb | postgres

# ── MariaDB / MySQL (nur wenn STORAGE_BACKEND=mariadb) ────────────────────────
# Voraussetzung: npm install mysql2
# Datenbank anlegen:
#   CREATE DATABASE isms_builder CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'isms'@'localhost' IDENTIFIED BY 'yourpass';
#   GRANT ALL PRIVILEGES ON isms_builder.* TO 'isms'@'localhost';
# Migration: node tools/migrate-json-to-mariadb.js
#
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=isms
# DB_PASS=yourpass
# DB_NAME=isms_builder
# DB_SSL=false              # true für TLS-verschlüsselte Verbindung

# ── Reverse-Proxy (nur setzen, wenn tatsächlich einer davorsteht!) ────────────
# Ohne TRUST_PROXY vertraut die App keinem X-Forwarded-*-Header — sicherer
# Standard. Wer die App hinter einem Reverse-Proxy betreibt (nginx/Caddy/
# Traefik, typisch in segmentierten Netzen/DMZ-Aufbauten), muss das bewusst
# aktivieren, sonst könnte ein Client die Header selbst fälschen (Audit-IP
# der Richtlinien-Bestätigung, Ziel-Domain in Bestätigungs-Mail-Links).
# TRUST_PROXY=1              # genau ein Reverse-Proxy davor (Standardfall)
# PUBLIC_URL=https://isms.example.com   # überschreibt Host/Protokoll ganz —
#                              zuverlässiger als TRUST_PROXY, wenn der extern
#                              sichtbare Host sich vom internen unterscheidet

# ── SSL/HTTPS (optional) ──────────────────────────────────────────────────────
# SSL_CERT_FILE=ssl/cert.pem
# SSL_KEY_FILE=ssl/key.pem

# ── E-Mail / SMTP (optional) ──────────────────────────────────────────────────
# Ohne SMTP_HOST sind alle E-Mail-Benachrichtigungen deaktiviert.
# Benachrichtigungen selbst werden in Admin → Organisation → E-Mail konfiguriert.
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false            # true für Port 465 (TLS), false für STARTTLS
# SMTP_USER=isms@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=ISMS Builder <isms@example.com>
#
# Beispiel für Gmail (App-Passwort erforderlich):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=abcd-efgh-ijkl-mnop
# SMTP_FROM=ISMS Builder <your@gmail.com>
#
# Beispiel für Office 365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=isms@yourcompany.com
# SMTP_PASS=your-password
# SMTP_FROM=ISMS Builder <isms@yourcompany.com>

# ── WebDAV-Publish / Nextcloud-Sichtbarkeit (optional) ────────────────────────
# Verbindungsdaten selbst (Basis-URL, Benutzername, App-Passwort, Zielordner)
# werden in Admin → Organisation → WebDAV-Publish konfiguriert, nicht hier.
# Diese zwei Schalter steuern nur, wie sichtbar veroeffentlichte Richtlinien
# fuer Nextcloud/ownCloud-Nutzer werden — beide sind rein additiv: schlagen sie
# fehl, bleibt der eigentliche PDF-Upload trotzdem gueltig.
#
# WEBDAV_MARK_FAVORITE=true      # Zielordner als Favorit markieren (oc:favorite) —
#                                 # erscheint bei jedem Nutzer mit Zugriff unter
#                                 # Dateien > Favoriten weiter oben
# WEBDAV_CREATE_SHARE_LINK=true  # oeffentlichen Lesezugriffs-Link je Publish anlegen,
#                                 # sichtbar im Template-Editor beim Publish-Status
