{
  "name": "isms-build",
  "version": "1.37.0",
  "description": "ISMS Template Builder – Build Mode",
  "scripts": {
    "start": "node server/index.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "security:check": "bash scripts/security-check.sh",
    "security:audit": "npm audit --audit-level=high",
    "security:outdated": "npm outdated",
    "preflight": "npm test && npm run preflight:pinned && npm audit --audit-level=high",
    "preflight:pinned": "node -e \"const v=require('./node_modules/pdf-parse/package.json').version; if (v !== '1.1.1') { console.error('FEHLER: pdf-parse ist ' + v + ' — muss exakt 1.1.1 sein (siehe PINNED-DEPS.md)'); process.exit(1) } console.log('pdf-parse ' + v + ' korrekt gepinnt')\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.2.9",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "pdf-parse": "1.1.1",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "xml2js": "^0.6.2"
  },
  "optionalDependencies": {
    "mysql2": "^3.23.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "puppeteer": "^24.43.1",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "body-parser": "^1.20.6",
    "brace-expansion": "^5.0.8"
  }
}
